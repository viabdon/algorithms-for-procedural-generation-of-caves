# Ferramentas de tools/: só o código e a documentação são versionados. A entrada
# (data/processed/references) vem do PLY em data/, as saídas são regeneradas e os
# artigos são das editoras.
/tools/flood_fill/npz/
/tools/flood_fill/plots/
/tools/sdf/articles/
/tools/sdf/npz/
/tools/sdf/plots/

# Projeto base do Random Walk (Unity, de outro TCC): só para refazer a exportação
# dos waypoints para configs/random_walk/
/external/

# Experimento do Indian Tunnel: a nuvem fica em data/raw/nasa, as saídas são regeneradas
/indian_tunnel_temp/npz/
/indian_tunnel_temp/plots/

# Random Walk com pontos sorteados (tools/): as saídas são regeneradas
/tools/random_walk_points/npz/
/tools/random_walk_points/results/
/tools/random_walk_points/plots/

# Keep directory placeholders
!.gitkeep

