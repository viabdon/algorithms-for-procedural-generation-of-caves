# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-gan/
.pytest_cache/
/tmp/
.env

# Notebooks
.ipynb_checkpoints/

# Dados brutos e derivados (amostras, normais, malhas reconstruídas, SDF/TSDF)
/data/raw/*
/data/processed/**
!/data/processed/**/
!/data/processed/**/.gitkeep
!/data/processed/README.md
!/data/processed/manifest.json
/data/external/*
# Caminho legado substituído por data/processed/references.
/data/references/

# Resultados gerados e busca de parâmetros do CA
/results/csv/*
/results/figures/*
/results/meshes/*
/results/optimization/*
/results/profiling/*
/results/volumes/*
/models/checkpoints/*

# Ferramentas de src/cavegen/tools/: só o código e a documentação são versionados.
# A entrada (data/processed/references) vem do PLY em data/, as saídas são
# regeneradas e os artigos são das editoras.
/src/cavegen/tools/flood_fill/npz/
/src/cavegen/tools/flood_fill/plots/
/src/cavegen/tools/sdf/articles/
/src/cavegen/tools/sdf/npz/
/src/cavegen/tools/sdf/plots/

# Projeto base do Random Walk (Unity, de outro TCC): só para refazer a exportação
# dos waypoints para configs/random_walk/
/external/

# Experimento do Indian Tunnel: a nuvem fica em data/raw/nasa, as saídas são regeneradas
/indian_tunnel_temp/npz/
/indian_tunnel_temp/plots/

# Random Walk com pontos sorteados (src/cavegen/tools/): as saídas são regeneradas
/src/cavegen/tools/random_walk_points/npz/
/src/cavegen/tools/random_walk_points/results/
/src/cavegen/tools/random_walk_points/plots/

# Keep directory placeholders
!.gitkeep

# Unity
/unity/Library/
/unity/Temp/
/unity/Obj/
/unity/Build/
/unity/Builds/
/unity/Logs/
/unity/UserSettings/

# OS / IDE
.DS_Store
.vscode/
.idea/

# CA
/src/cavegen/generators/cellular_automata/results
/src/cavegen/generators/cellular_automata/plots
/src/cavegen/generators/cellular_automata/seeds
/src/cavegen/generators/cellular_automata/pesos
# GA do CA: as pastas do pipeline ficam (com .gitkeep), o conteúdo não. As cavernas
# de entrada são dados, os campos são regenerados e os resultados são execuções.
/src/cavegen/generators/cellular_automata/genetico/1_entrada/*
/src/cavegen/generators/cellular_automata/genetico/2_campos/*
/src/cavegen/generators/cellular_automata/genetico/3_resultados/*
!/src/cavegen/generators/cellular_automata/genetico/*/.gitkeep

# Random Walk
/src/cavegen/generators/random_walk/npz
/src/cavegen/generators/random_walk/plots
/src/cavegen/generators/random_walk/results

# Instruções locais para agentes
prompt-professor-codex.md
AGENTS.md
CLAUDE.md
